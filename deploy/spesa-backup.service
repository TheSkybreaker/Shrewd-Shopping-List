# /etc/systemd/system/spesa-backup.service, started by spesa-backup.timer.
[Unit]
Description=Copy the newest Spesa backup off the server
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=spesa
Group=spesa
EnvironmentFile=/opt/spesa/.env
ExecStart=/opt/spesa/backup.sh
